{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabledoc.queria.io/schemas/dataset/v1.json",
  "title": "tabledoc dataset (tabledoc.yml)",
  "description": "The description of one dataset, in tabledoc.yml at the root. Tables are described in their own files; see table/v1.json.",
  "type": "object",
  "required": ["$schema", "name"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://tabledoc.queria.io/schemas/dataset/v1.json" },
    "name": { "$ref": "#/$defs/name" },
    "title": { "$ref": "#/$defs/text", "minLength": 1 },
    "title_reading": { "$ref": "#/$defs/text", "description": "How the title is read, such as its kana in Japanese." },
    "description": { "$ref": "#/$defs/text" },
    "topics": { "$ref": "#/$defs/texts", "description": "Topics, as a repository's topics on GitHub." },
    "synonyms": { "$ref": "#/$defs/texts", "description": "Other names people search for it by." },
    "homepage": { "$ref": "#/$defs/text" },
    "repository": { "type": "string", "format": "uri" },
    "language": { "$ref": "#/$defs/language" },
    "issued": { "$ref": "#/$defs/date" },
    "update_frequency": { "$ref": "#/$defs/updateFrequency" },
    "licenses": { "$ref": "#/$defs/licenses" },
    "sources": { "$ref": "#/$defs/sources" },
    "contributors": { "$ref": "#/$defs/contributors" },
    "temporal_coverage": { "$ref": "#/$defs/temporalCoverage" },
    "spatial_coverage": { "$ref": "#/$defs/spatialCoverage" },
    "image": { "$ref": "#/$defs/path", "description": "Path of an image that stands for the dataset, relative to the root. It is sent with the documents." },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "title": { "$ref": "#/$defs/text" },
          "title_reading": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "topics": { "$ref": "#/$defs/texts" },
          "synonyms": { "$ref": "#/$defs/texts" },
          "documents": { "$ref": "#/$defs/paths", "description": "Paths of the schema's documents, relative to the root. They go into the schema's folder by file name; README.md is its guide." }
        }
      }
    },
    "documents": {
      "$ref": "#/$defs/paths",
      "description": "Paths of the dataset's documents, relative to the root. They go into the dataset's root by file name. README.md at the root is one without being listed."
    },
    "annotations": { "$ref": "#/$defs/annotations" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "tag": { "type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$", "description": "A BCP 47 language tag." },
    "text": {
      "description": "Text in the dataset's language, or a map from a BCP 47 tag to the text in that language.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/tag" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      ]
    },
    "texts": {
      "description": "A list of text in the dataset's language, or a map from a BCP 47 tag to the list in that language.",
      "oneOf": [
        { "$ref": "#/$defs/strings" },
        { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/tag" }, "additionalProperties": { "$ref": "#/$defs/strings", "minItems": 1 } }
      ]
    },
    "path": { "type": "string", "minLength": 1 },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$", "description": "BCP 47 tag of the language of the text written without one." },
    "date": { "type": "string", "description": "YYYY-MM-DD." },
    "updateFrequency": { "enum": ["continuous", "daily", "weekly", "monthly", "quarterly", "yearly", "irregular"] },
    "licenses": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "description": "A license's id: one another entry defines, or an SPDX identifier such as CC-BY-4.0." },
          {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "description": "Short and fixed: the other entries and the tables refer to the license by it. An SPDX identifier when the license has one." },
              "url": { "$ref": "#/$defs/text" },
              "title": { "$ref": "#/$defs/text" },
              "commercial_use": { "type": "boolean" },
              "share_alike": { "type": "boolean" },
              "attribution_required": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "description": "The id of a source another entry defines." },
          {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "description": "Short and fixed: the other entries and the tables refer to the source by it." },
              "title": { "$ref": "#/$defs/text" },
              "url": { "$ref": "#/$defs/text" }
            }
          }
        ]
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "$ref": "#/$defs/text" },
          "url": { "$ref": "#/$defs/text" },
          "roles": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "temporalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": ["string", "integer", "null"] },
        "end": { "type": ["string", "integer", "null"], "description": "Empty while the data is still updated." }
      }
    },
    "spatialCoverage": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?:[A-Z]{2}|[0-9]{6})$" },
      "description": "ISO 3166-1 alpha-2 country codes, or 6-digit Japanese local government codes."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": { "type": "object" },
      "description": "Keys for other readers, by the reader's name. tabledoc copies them as they are."
    }
  }
}
