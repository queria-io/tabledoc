{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queria-io.github.io/tabledoc/schemas/dataset/v1.json",
  "title": "tabledoc dataset (tabledoc.yml)",
  "description": "The description of one dataset, in tabledoc.yml at the root. Tables are described in their own files; see table/v1.json.",
  "type": "object",
  "required": ["$schema", "name"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://queria-io.github.io/tabledoc/schemas/dataset/v1.json" },
    "name": { "$ref": "#/$defs/name" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "keywords": { "$ref": "#/$defs/strings" },
    "homepage": { "type": "string", "format": "uri" },
    "language": { "$ref": "#/$defs/language" },
    "issued": { "$ref": "#/$defs/date" },
    "update_frequency": { "$ref": "#/$defs/updateFrequency" },
    "licenses": { "$ref": "#/$defs/licenses" },
    "sources": { "$ref": "#/$defs/sources" },
    "contributors": { "$ref": "#/$defs/contributors" },
    "temporal_coverage": { "$ref": "#/$defs/temporalCoverage" },
    "spatial_coverage": { "$ref": "#/$defs/spatialCoverage" },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "guide": { "$ref": "#/$defs/path", "description": "Path of the schema's guide, relative to the root." }
        }
      }
    },
    "docs": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "description": "Paths of documents that belong to no one table, relative to the root, in the order they are shown."
    },
    "queria": { "type": "object", "description": "Keys only Queria reads. Queria checks them." },
    "annotations": { "$ref": "#/$defs/annotations" }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "path": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$", "description": "BCP 47 tag of the language the description is written in." },
    "date": { "type": "string", "description": "YYYY-MM-DD." },
    "updateFrequency": { "enum": ["continuous", "daily", "weekly", "monthly", "quarterly", "yearly", "irregular"] },
    "licenses": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "description": "A license id, such as CC-BY-4.0." },
          {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "spdx": { "type": "string" },
              "url": { "type": "string" },
              "title": { "type": "string" },
              "commercial_use": { "type": "boolean" },
              "share_alike": { "type": "boolean" },
              "attribution_required": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "title": { "type": "string" }, "path": { "type": "string" } }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "path": { "type": "string" },
          "roles": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "temporalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": ["string", "integer", "null"] },
        "end": { "type": ["string", "integer", "null"], "description": "Empty while the data is still updated." }
      }
    },
    "spatialCoverage": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(?:[A-Z]{2}|[0-9]{6})$" },
      "description": "ISO 3166-1 alpha-2 country codes, or 6-digit Japanese local government codes."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": { "type": "object" },
      "description": "Keys for other readers, by the reader's name. tabledoc copies them as they are."
    }
  }
}
