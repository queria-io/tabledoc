{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queria-io.github.io/tabledoc/schemas/table/v1.json",
  "title": "tabledoc table (<schema>/<table>.yml)",
  "description": "The description of one table. The keys follow one entry of dbt's `models:`; keys dbt does not have sit at the same level. Types, nullability and row counts are not written here.",
  "type": "object",
  "required": ["$schema"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://queria-io.github.io/tabledoc/schemas/table/v1.json" },
    "name": { "type": "string", "minLength": 1, "description": "The table's name. Defaults to the file name." },
    "table": { "type": "string", "pattern": "^[^.\\s]+\\.[^.\\s]+$", "description": "<schema>.<table>. Wins over the file's place." },
    "title": { "$ref": "../dataset/v1.json#/$defs/text" },
    "description": { "$ref": "../dataset/v1.json#/$defs/text" },
    "topics": { "$ref": "../dataset/v1.json#/$defs/texts" },
    "keywords": { "$ref": "../dataset/v1.json#/$defs/texts", "description": "The earlier name of topics, read as topics." },
    "primary_key": { "$ref": "#/$defs/columnNames" },
    "licenses": { "$ref": "../dataset/v1.json#/$defs/licenses" },
    "sources": { "$ref": "../dataset/v1.json#/$defs/sources" },
    "temporal_coverage": { "$ref": "../dataset/v1.json#/$defs/temporalCoverage" },
    "spatial_coverage": { "$ref": "../dataset/v1.json#/$defs/spatialCoverage" },
    "sql": { "type": "string", "description": "The SQL the table is made from, for a table dbt does not build." },
    "depends_on": { "$ref": "../dataset/v1.json#/$defs/strings" },
    "docs": { "$ref": "../dataset/v1.json#/$defs/paths", "description": "Paths of the table's other documents, relative to the root. They go into the table's folder by file name." },
    "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "queria": { "type": "object", "description": "Keys only Queria reads. Queria checks them." },
    "annotations": { "$ref": "../dataset/v1.json#/$defs/annotations" }
  },
  "$defs": {
    "columnNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "entityType": { "enum": ["primary", "unique", "foreign", "natural"] },
    "entity": {
      "description": "A join key. `name` is the vocabulary the values come from, such as corporate_number.",
      "oneOf": [
        { "$ref": "#/$defs/entityType" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "$ref": "#/$defs/entityType" }, "name": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "dimensionType": { "enum": ["categorical", "time"] },
    "dimension": {
      "description": "A column to filter and group by.",
      "oneOf": [
        { "$ref": "#/$defs/dimensionType" },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "$ref": "#/$defs/dimensionType" }, "name": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "granularity": { "type": "string", "minLength": 1, "description": "How fine a time dimension is: day, month, year, ..." },
    "column": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "$ref": "../dataset/v1.json#/$defs/text" },
        "description": { "$ref": "../dataset/v1.json#/$defs/text" },
        "asset": { "type": "boolean", "description": "The value is the path of a file that belongs to the row." },
        "entity": { "$ref": "#/$defs/entity" },
        "dimension": { "$ref": "#/$defs/dimension" },
        "granularity": { "$ref": "#/$defs/granularity" },
        "annotations": { "$ref": "../dataset/v1.json#/$defs/annotations" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "agg": { "type": "string", "minLength": 1, "description": "sum, max, count_distinct, ..." },
        "expr": { "type": "string", "minLength": 1 },
        "description": { "$ref": "../dataset/v1.json#/$defs/text" }
      }
    }
  }
}
